{
  "id": "/",
  "name": "Accounter",
  "short_name": "Accounter",
  "description": "End-to-end bookkeeping for Israeli businesses: bank, card, crypto and payroll activity collected daily, invoices read from email, every transaction matched to its document, and the ledger, VAT and annual reports kept ready.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["finance", "business", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    {
      "src": "/icons/accounter-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/wide-home.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Today at a glance: cash, net for the month, and what is waiting for your approval"
    },
    {
      "src": "/screenshots/wide-how-it-works.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Transactions and documents in, matched ledger and tax files out"
    },
    {
      "src": "/screenshots/narrow-home.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Your books on autopilot, on your phone"
    },
    {
      "src": "/screenshots/narrow-dashboard.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Today at a glance"
    }
  ],
  "shortcuts": [
    {
      "name": "Charges",
      "url": "/charges",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Missing info",
      "url": "/charges/missing-info",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Documents",
      "url": "/documents",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Monthly VAT",
      "url": "/reports/vat-monthly",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
